{
  "name": "scriptstash",
  "productName": "ScriptStash",
  "version": "2.5.18",
  "description": "Third-party browser and organizer for script communities",
  "main": "main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mememan2010gaming/ScriptStash.git"
  },
  "bugs": {
    "url": "https://github.com/mememan2010gaming/ScriptStash/issues"
  },
  "homepage": "https://github.com/mememan2010gaming/ScriptStash/#readme",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.js",
    "start": "electron-forge start",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron-forge start -- --dev\"",
    "dev:electron": "electron-forge start -- --dev",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && electron-forge package",
    "package": "npm run build:renderer && electron-forge package",
    "make": "npm run build:renderer && electron-forge make",
    "lint": "eslint --ext .js,.jsx .",
    "lint:fix": "eslint --ext .js,.jsx . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:verbose": "jest --verbose",
    "prepare": "echo 'Ready for development'",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "electron",
    "scripts",
    "browser",
    "downloader",
    "desktop-app"
  ],
  "author": "ScriptStash Contributors",
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.2.0",
    "@electron-forge/plugin-fuses": "^7.2.0",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^26.15.3",
    "electron-mock-ipc": "^0.3.14",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^6.6.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.7.4",
    "spectron": "^19.0.0",
    "vite": "^8.0.1",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "eslint": "^9.39.2",
    "@eslint/js": "^9.39.2",
    "@eslint/eslintrc": "^3.3.3",
    "@humanwhocodes/config-array": "npm:@eslint/config-array@^1.0.0",
    "@humanwhocodes/object-schema": "npm:@eslint/object-schema@^1.0.0",
    "get-folder-size": "^5.0.0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "animejs": "^4.4.1",
    "axios": "^1.13.2",
    "buttplug": "^5.0.1",
    "cheerio": "^1.0.0-rc.12",
    "dompurify": "^3.0.6",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "jsdom": "^23.0.1",
    "megajs": "^1.3.10",
    "node-fetch": "^2.7.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "update-electron-app": "^3.2.0",
    "yt-dlp-wrap": "^2.3.12"
  }
}
